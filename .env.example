# 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# LLM API 配置（DeepSeek 或任意 OpenAI 兼容 API）
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.deepseek.com/v1

# 默认模型配置
DEFAULT_MODEL=deepseek-chat
DEFAULT_TEMPERATURE=0.7

# 可选 PostgreSQL 快照存储（v0.4 CLI HITL 本身不依赖数据库）
# POSTGRES_CONNECTION_STRING=postgresql://aro:change-me@localhost:5432/aro
# 真实数据库集成测试请使用专用测试库
# ARO_TEST_POSTGRES_CONNECTION_STRING=postgresql://aro:change-me@localhost:5432/aro_test

# v0.5 HTTP API（默认无认证，仅绑定本机使用）
ARO_API_CONFIG=projects/helpdesk/config/agent_api.yml
# 可选共享访问令牌：设置后 chat/approve 要求 Bearer；不是模型 API Key
# ARO_API_TOKEN=replace-with-a-random-local-access-token
ARO_API_SESSION_TTL_SECONDS=3600
ARO_API_MAX_SESSIONS=64
ARO_API_MAX_MESSAGES=300
ARO_API_TURN_TIMEOUT_SECONDS=600
# 人工审批默认 300 秒，在 agent_api.yml 的 capability_config.hitl.timeout_seconds 修改

# 可选 L2：在项目自定义 YAML 启用 memory，见 capabilities/memory/README.md
# 仅本机单用户测试可设置固定可信身份；多人服务不得共享身份
# ARO_API_USER_ID=local-demo-user
ARO_API_TENANT_ID=local

# v0.9：显式选择多会话知识库配置（默认仍为轻量业务 profile）
# ARO_API_CONFIG=projects/helpdesk/config/agent_api_knowledge.yml
# 远端 Qdrant 请在 agent_api_knowledge.yml 按注释切换存储字段
# 远端认证可在 YAML 设 qdrant_api_key_env: ARO_QDRANT_API_KEY，真实值仅放环境变量
# ARO_QDRANT_API_KEY=
